rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Security Primitives
    // -------------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'tjw2026tjwang@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() ||
        (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isApprover() {
      return isAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['approver', 'admin']
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidApproverList(listVal) {
      return listVal is list && listVal.size() <= 10 &&
        (listVal.size() == 0 || (listVal[0] is string && listVal[0].size() <= 128));
    }

    function isValidServiceLines(listVal) {
      return listVal is list && listVal.size() >= 1 && listVal.size() <= 5 &&
        listVal.hasOnly(['CoSec', 'Accounting', 'Audit', 'Tax', 'Payroll']);
    }

    function isValidHolidays(listVal) {
      return listVal is list && listVal.size() <= 50 &&
        (listVal.size() == 0 || (listVal[0] is string && listVal[0].size() <= 20));
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints
    // -------------------------------------------------------------------------
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'department', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'department', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        isValidString(data.email, 3, 150) &&
        isValidString(data.displayName, 1, 120) &&
        data.role in ['pic', 'approver', 'admin'] &&
        data.department in ['CoSec', 'Accounting', 'Audit', 'Tax', 'Payroll', 'Management'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'grantedBy', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'grantedBy', 'createdAt']) &&
        isValidId(data.uid) &&
        isValidString(data.grantedBy, 1, 128) &&
        data.createdAt is timestamp;
    }

    function isValidOrgConfig(data) {
      return data.keys().hasAll(['slaWorkingDays', 'publicHolidays', 'departmentPics', 'approverIds', 'updatedBy', 'updatedAt']) &&
        data.keys().hasOnly(['slaWorkingDays', 'publicHolidays', 'departmentPics', 'approverIds', 'updatedBy', 'updatedAt']) &&
        data.slaWorkingDays is int && data.slaWorkingDays >= 1 && data.slaWorkingDays <= 30 &&
        isValidHolidays(data.publicHolidays) &&
        data.departmentPics is map &&
        data.departmentPics.keys().hasOnly(['CoSec', 'Accounting', 'Audit', 'Tax', 'Payroll']) &&
        isValidApproverList(data.approverIds) &&
        isValidString(data.updatedBy, 1, 128) &&
        data.updatedAt is timestamp;
    }

    function isValidLead(data) {
      return data.keys().hasAll([
          'leadCode', 'emailSubject', 'rawEmailBody', 'companyName', 'contactPerson',
          'contactEmail', 'contactPhone', 'inquirySummary', 'serviceLines', 'assignedDept',
          'assignedPicId', 'assignedPicName', 'createdBy', 'approverIds', 'receivedAtIso',
          'contactStatus', 'firstContactAtIso', 'outreachChannel', 'outreachNotes',
          'slaStatus', 'escalationSentAtIso', 'escalationCount', 'scopeCompleted',
          'entityType', 'annualTurnoverMyr', 'monthlyBankTxCount', 'headcount',
          'accountingState', 'sstRegistered', 'scopeNotes', 'workflowStage',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'leadCode', 'emailSubject', 'rawEmailBody', 'companyName', 'contactPerson',
          'contactEmail', 'contactPhone', 'inquirySummary', 'serviceLines', 'assignedDept',
          'assignedPicId', 'assignedPicName', 'createdBy', 'approverIds', 'receivedAtIso',
          'contactStatus', 'firstContactAtIso', 'outreachChannel', 'outreachNotes',
          'slaStatus', 'escalationSentAtIso', 'escalationCount', 'scopeCompleted',
          'entityType', 'annualTurnoverMyr', 'monthlyBankTxCount', 'headcount',
          'accountingState', 'sstRegistered', 'scopeNotes', 'workflowStage',
          'createdAt', 'updatedAt'
        ]) &&
        isValidString(data.leadCode, 3, 30) &&
        isValidString(data.emailSubject, 0, 240) &&
        isValidString(data.rawEmailBody, 0, 10000) &&
        isValidString(data.companyName, 1, 255) &&
        isValidString(data.contactPerson, 1, 150) &&
        isValidString(data.contactEmail, 0, 150) &&
        isValidString(data.contactPhone, 0, 50) &&
        isValidString(data.inquirySummary, 0, 2000) &&
        isValidServiceLines(data.serviceLines) &&
        data.assignedDept in ['CoSec', 'Accounting', 'Audit', 'Tax', 'Payroll'] &&
        isValidId(data.assignedPicId) &&
        isValidString(data.assignedPicName, 1, 120) &&
        isValidId(data.createdBy) &&
        isValidApproverList(data.approverIds) &&
        isValidString(data.receivedAtIso, 10, 40) &&
        data.contactStatus in ['Pending Contact', 'Contacted', 'Unreachable / Disqualified'] &&
        isValidString(data.firstContactAtIso, 0, 40) &&
        data.outreachChannel in ['', 'Phone', 'WhatsApp', 'Email'] &&
        isValidString(data.outreachNotes, 0, 2000) &&
        data.slaStatus in ['Pending', 'Compliant', 'Breached'] &&
        isValidString(data.escalationSentAtIso, 0, 40) &&
        data.escalationCount is int && data.escalationCount >= 0 && data.escalationCount <= 100 &&
        data.scopeCompleted is bool &&
        data.entityType in ['', 'Sdn Bhd', 'Sole Prop', 'LLP', 'Partnership', 'Bhd', 'Labuan'] &&
        data.annualTurnoverMyr is number && data.annualTurnoverMyr >= 0 && data.annualTurnoverMyr <= 10000000000 &&
        data.monthlyBankTxCount is int && data.monthlyBankTxCount >= 0 && data.monthlyBankTxCount <= 1000000 &&
        data.headcount is int && data.headcount >= 0 && data.headcount <= 100000 &&
        data.accountingState in ['', 'Up-to-date', 'Backlog (1-6 months)', 'Backlog (>6 months)', 'New Incorporation'] &&
        data.sstRegistered is bool &&
        isValidString(data.scopeNotes, 0, 4000) &&
        data.workflowStage in ['Triage', 'Outreach', 'Scope', 'Quotation', 'Approval', 'Dispatched', 'Disqualified'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidQuotation(data) {
      return data.keys().hasAll([
          'quoteNumber', 'leadId', 'companyName', 'assignedPicId', 'createdBy', 'approverIds',
          'scopeNotes', 'legalRemarks', 'assumptions', 'exclusions', 'totalSetupMyr',
          'totalMonthlyMyr', 'totalAnnualMyr', 'totalContractValueMyr', 'status', 'isApproved',
          'approvedBy', 'approvedByName', 'approvedAtIso', 'rejectionFeedback',
          'dispatchChannel', 'dispatchedAtIso', 'dispatchedBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'quoteNumber', 'leadId', 'companyName', 'assignedPicId', 'createdBy', 'approverIds',
          'scopeNotes', 'legalRemarks', 'assumptions', 'exclusions', 'totalSetupMyr',
          'totalMonthlyMyr', 'totalAnnualMyr', 'totalContractValueMyr', 'status', 'isApproved',
          'approvedBy', 'approvedByName', 'approvedAtIso', 'rejectionFeedback',
          'dispatchChannel', 'dispatchedAtIso', 'dispatchedBy', 'createdAt', 'updatedAt'
        ]) &&
        isValidString(data.quoteNumber, 3, 30) &&
        isValidId(data.leadId) &&
        isValidString(data.companyName, 1, 255) &&
        isValidId(data.assignedPicId) &&
        isValidId(data.createdBy) &&
        isValidApproverList(data.approverIds) &&
        isValidString(data.scopeNotes, 0, 4000) &&
        isValidString(data.legalRemarks, 0, 4000) &&
        isValidString(data.assumptions, 0, 3000) &&
        isValidString(data.exclusions, 0, 3000) &&
        data.totalSetupMyr is number && data.totalSetupMyr >= 0 && data.totalSetupMyr <= 100000000 &&
        data.totalMonthlyMyr is number && data.totalMonthlyMyr >= 0 && data.totalMonthlyMyr <= 100000000 &&
        data.totalAnnualMyr is number && data.totalAnnualMyr >= 0 && data.totalAnnualMyr <= 100000000 &&
        data.totalContractValueMyr is number && data.totalContractValueMyr >= 0 && data.totalContractValueMyr <= 1000000000 &&
        data.status in ['Draft', 'Pending Approval', 'Approved', 'Rejected', 'Quotation Sent'] &&
        data.isApproved is bool &&
        isValidString(data.approvedBy, 0, 128) &&
        isValidString(data.approvedByName, 0, 120) &&
        isValidString(data.approvedAtIso, 0, 40) &&
        isValidString(data.rejectionFeedback, 0, 2000) &&
        data.dispatchChannel in ['', 'Email', 'WhatsApp', 'Manual'] &&
        isValidString(data.dispatchedAtIso, 0, 40) &&
        isValidString(data.dispatchedBy, 0, 128) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLineItem(data, quotationId) {
      return data.keys().hasAll([
          'quotationId', 'serviceCategory', 'description', 'deliverables', 'frequency',
          'quantity', 'unitPriceMyr', 'lineTotalMyr', 'assignedPicId', 'createdBy',
          'approverIds', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'quotationId', 'serviceCategory', 'description', 'deliverables', 'frequency',
          'quantity', 'unitPriceMyr', 'lineTotalMyr', 'assignedPicId', 'createdBy',
          'approverIds', 'createdAt', 'updatedAt'
        ]) &&
        data.quotationId == quotationId &&
        data.serviceCategory in ['CoSec', 'Accounting', 'Audit', 'Tax', 'Payroll', 'Advisory'] &&
        isValidString(data.description, 1, 1000) &&
        isValidString(data.deliverables, 0, 1000) &&
        data.frequency in ['One-off', 'Monthly', 'Annual'] &&
        data.quantity is int && data.quantity >= 1 && data.quantity <= 10000 &&
        data.unitPriceMyr is number && data.unitPriceMyr >= 0 && data.unitPriceMyr <= 10000000 &&
        data.lineTotalMyr is number && data.lineTotalMyr >= 0 && data.lineTotalMyr <= 100000000 &&
        isValidId(data.assignedPicId) &&
        isValidId(data.createdBy) &&
        isValidApproverList(data.approverIds) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll([
          'entityType', 'entityId', 'entityLabel', 'action', 'actorUid',
          'actorName', 'actorRole', 'details', 'assignedPicId', 'approverIds', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'entityType', 'entityId', 'entityLabel', 'action', 'actorUid',
          'actorName', 'actorRole', 'details', 'assignedPicId', 'approverIds', 'createdAt'
        ]) &&
        data.entityType in ['Lead', 'Quotation', 'Config'] &&
        isValidId(data.entityId) &&
        isValidString(data.entityLabel, 1, 160) &&
        data.action in [
          'LEAD_INGESTED', 'OUTREACH_LOGGED', 'SLA_ESCALATED', 'SCOPE_RECORDED',
          'QUOTATION_GENERATED', 'QUOTATION_SUBMITTED', 'QUOTATION_APPROVED',
          'QUOTATION_REJECTED', 'QUOTATION_DISPATCHED', 'CONFIG_UPDATED'
        ] &&
        data.actorUid == request.auth.uid &&
        isValidString(data.actorName, 1, 120) &&
        isValidString(data.actorRole, 1, 40) &&
        isValidString(data.details, 1, 2000) &&
        isValidString(data.assignedPicId, 0, 128) &&
        isValidApproverList(data.approverIds) &&
        data.createdAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // /users/{userId} — PII-Isolated Staff Profiles
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) &&
        (request.auth.uid == userId || isAdmin());

      allow list: if isBootstrappedAdmin();

      allow create: if isVerifiedUser() && isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        request.auth.uid == userId &&
        incoming().uid == userId &&
        incoming().email == request.auth.token.email &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (incoming().role == 'pic' || isBootstrappedAdmin());

      allow update: if isVerifiedUser() && isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (request.auth.uid == userId &&
            incoming().role == existing().role &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'department', 'updatedAt'])) ||
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'department', 'updatedAt']))
        );

      allow delete: if isAdmin() && isValidId(userId);
    }

    // -------------------------------------------------------------------------
    // /admins/{userId} — Privileged Admin Registry
    // -------------------------------------------------------------------------
    match /admins/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) &&
        (request.auth.uid == userId || isAdmin());

      allow list: if isBootstrappedAdmin();

      allow create: if isBootstrappedAdmin() && isValidId(userId) &&
        isValidAdminRecord(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time;

      allow update: if false;
      allow delete: if isBootstrappedAdmin() && isValidId(userId);
    }

    // -------------------------------------------------------------------------
    // /settings/{configId} — SLA Thresholds, Holidays, Department PIC Routing
    // -------------------------------------------------------------------------
    match /settings/{configId} {
      allow get: if isVerifiedUser() && isValidId(configId);
      allow list: if false;

      allow create: if isVerifiedUser() && isValidId(configId) &&
        isValidOrgConfig(incoming()) &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if isVerifiedUser() && isValidId(configId) &&
        isValidOrgConfig(incoming()) &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'slaWorkingDays', 'publicHolidays', 'departmentPics', 'approverIds', 'updatedBy', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /leads/{leadId} — Corporate Advisory Leads (Steps 1–5)
    // -------------------------------------------------------------------------
    match /leads/{leadId} {
      allow get: if isVerifiedUser() && isValidId(leadId) && (
        existing().assignedPicId == request.auth.uid ||
        existing().createdBy == request.auth.uid ||
        request.auth.uid in existing().approverIds ||
        isApprover() ||
        isAdmin()
      );

      allow list: if isVerifiedUser() && (
        isBootstrappedAdmin() ||
        resource.data.assignedPicId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        request.auth.uid in resource.data.approverIds
      );

      allow create: if isVerifiedUser() && isValidId(leadId) &&
        isValidLead(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() && isValidId(leadId) &&
        isValidLead(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().leadCode == existing().leadCode &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          ((existing().assignedPicId == request.auth.uid || existing().createdBy == request.auth.uid) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'contactStatus', 'firstContactAtIso', 'outreachChannel', 'outreachNotes',
              'slaStatus', 'workflowStage', 'updatedAt'
            ])) ||
          ((existing().assignedPicId == request.auth.uid || existing().createdBy == request.auth.uid) &&
            existing().contactStatus == 'Contacted' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'scopeCompleted', 'entityType', 'annualTurnoverMyr', 'monthlyBankTxCount',
              'headcount', 'accountingState', 'sstRegistered', 'scopeNotes',
              'serviceLines', 'workflowStage', 'updatedAt'
            ])) ||
          ((existing().assignedPicId == request.auth.uid || existing().createdBy == request.auth.uid || isApprover()) &&
            existing().contactStatus == 'Pending Contact' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'slaStatus', 'escalationSentAtIso', 'escalationCount', 'updatedAt'
            ])) ||
          ((existing().assignedPicId == request.auth.uid || existing().createdBy == request.auth.uid || isApprover()) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['workflowStage', 'updatedAt']))
        );

      allow delete: if isAdmin() && isValidId(leadId);
    }

    // -------------------------------------------------------------------------
    // /quotations/{quotationId} — AI Quotations & Hard Approval Gate (Steps 6–8)
    // -------------------------------------------------------------------------
    match /quotations/{quotationId} {
      allow get: if isVerifiedUser() && isValidId(quotationId) && (
        existing().assignedPicId == request.auth.uid ||
        existing().createdBy == request.auth.uid ||
        request.auth.uid in existing().approverIds ||
        isApprover() ||
        isAdmin()
      );

      allow list: if isVerifiedUser() && (
        isBootstrappedAdmin() ||
        resource.data.assignedPicId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        request.auth.uid in resource.data.approverIds
      );

      allow create: if isVerifiedUser() && isValidId(quotationId) &&
        isValidQuotation(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().isApproved == false &&
        incoming().status in ['Draft', 'Pending Approval'] &&
        incoming().approvedBy == '' &&
        incoming().approvedAtIso == '' &&
        incoming().dispatchedAtIso == '' &&
        incoming().dispatchedBy == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/leads/$(incoming().leadId));

      allow update: if isVerifiedUser() && isValidId(quotationId) &&
        isValidQuotation(incoming()) &&
        incoming().leadId == existing().leadId &&
        incoming().quoteNumber == existing().quoteNumber &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (existing().status != 'Quotation Sent' || isAdmin()) && (
          ((existing().assignedPicId == request.auth.uid || existing().createdBy == request.auth.uid || isAdmin()) &&
            existing().status in ['Draft', 'Rejected'] &&
            existing().isApproved == false &&
            incoming().isApproved == false &&
            incoming().status in ['Draft', 'Pending Approval'] &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'scopeNotes', 'legalRemarks', 'assumptions', 'exclusions',
              'totalSetupMyr', 'totalMonthlyMyr', 'totalAnnualMyr', 'totalContractValueMyr',
              'status', 'rejectionFeedback', 'updatedAt'
            ])) ||
          (isApprover() &&
            existing().status == 'Pending Approval' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'isApproved', 'approvedBy', 'approvedByName', 'approvedAtIso',
              'status', 'rejectionFeedback', 'updatedAt'
            ]) && (
              (incoming().isApproved == true &&
                incoming().status == 'Approved' &&
                incoming().approvedBy == request.auth.uid &&
                incoming().approvedAtIso.size() >= 10) ||
              (incoming().isApproved == false &&
                incoming().status == 'Rejected' &&
                incoming().approvedBy == '' &&
                incoming().rejectionFeedback.size() >= 1)
            )) ||
          ((existing().assignedPicId == request.auth.uid || existing().createdBy == request.auth.uid || isApprover() || isAdmin()) &&
            existing().isApproved == true &&
            existing().status == 'Approved' &&
            incoming().isApproved == true &&
            incoming().status == 'Quotation Sent' &&
            incoming().dispatchChannel in ['Email', 'WhatsApp', 'Manual'] &&
            incoming().dispatchedAtIso.size() >= 10 &&
            incoming().dispatchedBy == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'dispatchChannel', 'dispatchedAtIso', 'dispatchedBy', 'updatedAt'
            ])) ||
          isAdmin()
        );

      allow delete: if isAdmin() && isValidId(quotationId);

      // -----------------------------------------------------------------------
      // /quotations/{quotationId}/lineItems/{itemId} — Master Gate Subcollection
      // -----------------------------------------------------------------------
      match /lineItems/{itemId} {
        function parentQuote() {
          return get(/databases/$(database)/documents/quotations/$(quotationId));
        }

        function parentExists() {
          return exists(/databases/$(database)/documents/quotations/$(quotationId));
        }

        allow get: if isVerifiedUser() && isValidId(quotationId) && isValidId(itemId) &&
          parentExists() && (
            parentQuote().data.assignedPicId == request.auth.uid ||
            parentQuote().data.createdBy == request.auth.uid ||
            request.auth.uid in parentQuote().data.approverIds ||
            isApprover() ||
            isAdmin()
          );

        allow list: if isVerifiedUser() && (
          isBootstrappedAdmin() ||
          resource.data.assignedPicId == request.auth.uid ||
          resource.data.createdBy == request.auth.uid ||
          request.auth.uid in resource.data.approverIds
        );

        allow create: if isVerifiedUser() && isValidId(quotationId) && isValidId(itemId) &&
          isValidLineItem(incoming(), quotationId) &&
          incoming().createdBy == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          parentExists() &&
          (parentQuote().data.status in ['Draft', 'Rejected'] || isAdmin()) &&
          (parentQuote().data.assignedPicId == request.auth.uid ||
            parentQuote().data.createdBy == request.auth.uid ||
            isAdmin());

        allow update: if isVerifiedUser() && isValidId(quotationId) && isValidId(itemId) &&
          isValidLineItem(incoming(), quotationId) &&
          incoming().quotationId == existing().quotationId &&
          incoming().createdBy == existing().createdBy &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          parentExists() &&
          (parentQuote().data.status in ['Draft', 'Rejected'] || isAdmin()) &&
          (parentQuote().data.assignedPicId == request.auth.uid ||
            parentQuote().data.createdBy == request.auth.uid ||
            isAdmin()) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'serviceCategory', 'description', 'deliverables', 'frequency',
            'quantity', 'unitPriceMyr', 'lineTotalMyr', 'updatedAt'
          ]);

        allow delete: if isVerifiedUser() && isValidId(quotationId) && isValidId(itemId) &&
          parentExists() &&
          (parentQuote().data.status in ['Draft', 'Rejected'] || isAdmin()) &&
          (parentQuote().data.assignedPicId == request.auth.uid ||
            parentQuote().data.createdBy == request.auth.uid ||
            isAdmin());
      }
    }

    // -------------------------------------------------------------------------
    // /auditLogs/{logId} — Immutable Operational & Approval Audit Trail
    // -------------------------------------------------------------------------
    match /auditLogs/{logId} {
      allow get: if isVerifiedUser() && isValidId(logId) && (
        existing().actorUid == request.auth.uid ||
        existing().assignedPicId == request.auth.uid ||
        request.auth.uid in existing().approverIds ||
        isApprover() ||
        isAdmin()
      );

      allow list: if isVerifiedUser() && (
        isBootstrappedAdmin() ||
        resource.data.actorUid == request.auth.uid ||
        resource.data.assignedPicId == request.auth.uid ||
        request.auth.uid in resource.data.approverIds
      );

      allow create: if isVerifiedUser() && isValidId(logId) &&
        isValidAuditLog(incoming()) &&
        incoming().createdAt == request.time;

      allow update: if false;
      allow delete: if false;
    }
  }
}

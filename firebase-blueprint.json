{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated staff member profile with RBAC role and assigned corporate advisory department.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["pic", "approver", "admin"] },
        "department": { "type": "string", "enum": ["CoSec", "Accounting", "Audit", "Tax", "Payroll", "Management"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "department", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Privileged system administrator registry used for RBAC verification.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "grantedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "grantedBy", "createdAt"]
    },
    "OrgConfig": {
      "title": "OrgConfig",
      "description": "Department PIC routing directory, SLA working-day threshold, and Malaysian public holiday calendar.",
      "type": "object",
      "properties": {
        "slaWorkingDays": { "type": "integer" },
        "publicHolidays": { "type": "array" },
        "departmentPics": { "type": "object" },
        "approverIds": { "type": "array" },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["slaWorkingDays", "publicHolidays", "departmentPics", "approverIds", "updatedBy", "updatedAt"]
    },
    "Lead": {
      "title": "Lead",
      "description": "Inbound corporate advisory prospect record with AI triage metadata, 4-day SLA tracking, and Step 4 scope specifications.",
      "type": "object",
      "properties": {
        "leadCode": { "type": "string", "minLength": 3, "maxLength": 30 },
        "emailSubject": { "type": "string", "maxLength": 240 },
        "rawEmailBody": { "type": "string", "maxLength": 10000 },
        "companyName": { "type": "string", "minLength": 1, "maxLength": 255 },
        "contactPerson": { "type": "string", "minLength": 1, "maxLength": 150 },
        "contactEmail": { "type": "string", "maxLength": 150 },
        "contactPhone": { "type": "string", "maxLength": 50 },
        "inquirySummary": { "type": "string", "maxLength": 2000 },
        "serviceLines": { "type": "array" },
        "assignedDept": { "type": "string", "enum": ["CoSec", "Accounting", "Audit", "Tax", "Payroll"] },
        "assignedPicId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "assignedPicName": { "type": "string", "maxLength": 120 },
        "createdBy": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "approverIds": { "type": "array" },
        "receivedAtIso": { "type": "string", "maxLength": 40 },
        "contactStatus": { "type": "string", "enum": ["Pending Contact", "Contacted", "Unreachable / Disqualified"] },
        "firstContactAtIso": { "type": "string", "maxLength": 40 },
        "outreachChannel": { "type": "string", "enum": ["", "Phone", "WhatsApp", "Email"] },
        "outreachNotes": { "type": "string", "maxLength": 2000 },
        "slaStatus": { "type": "string", "enum": ["Pending", "Compliant", "Breached"] },
        "escalationSentAtIso": { "type": "string", "maxLength": 40 },
        "escalationCount": { "type": "integer" },
        "scopeCompleted": { "type": "boolean" },
        "entityType": { "type": "string", "enum": ["", "Sdn Bhd", "Sole Prop", "LLP", "Partnership", "Bhd", "Labuan"] },
        "annualTurnoverMyr": { "type": "number" },
        "monthlyBankTxCount": { "type": "integer" },
        "headcount": { "type": "integer" },
        "accountingState": { "type": "string", "enum": ["", "Up-to-date", "Backlog (1-6 months)", "Backlog (>6 months)", "New Incorporation"] },
        "sstRegistered": { "type": "boolean" },
        "scopeNotes": { "type": "string", "maxLength": 4000 },
        "workflowStage": { "type": "string", "enum": ["Triage", "Outreach", "Scope", "Quotation", "Approval", "Dispatched", "Disqualified"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "leadCode", "emailSubject", "rawEmailBody", "companyName", "contactPerson", "contactEmail",
        "contactPhone", "inquirySummary", "serviceLines", "assignedDept", "assignedPicId", "assignedPicName",
        "createdBy", "approverIds", "receivedAtIso", "contactStatus", "firstContactAtIso", "outreachChannel",
        "outreachNotes", "slaStatus", "escalationSentAtIso", "escalationCount", "scopeCompleted",
        "entityType", "annualTurnoverMyr", "monthlyBankTxCount", "headcount", "accountingState",
        "sstRegistered", "scopeNotes", "workflowStage", "createdAt", "updatedAt"
      ]
    },
    "Quotation": {
      "title": "Quotation",
      "description": "AI-assisted corporate advisory quotation with mandatory finance approval gating prior to client dispatch.",
      "type": "object",
      "properties": {
        "quoteNumber": { "type": "string", "minLength": 3, "maxLength": 30 },
        "leadId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "companyName": { "type": "string", "minLength": 1, "maxLength": 255 },
        "assignedPicId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdBy": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "approverIds": { "type": "array" },
        "scopeNotes": { "type": "string", "maxLength": 4000 },
        "legalRemarks": { "type": "string", "maxLength": 4000 },
        "assumptions": { "type": "string", "maxLength": 3000 },
        "exclusions": { "type": "string", "maxLength": 3000 },
        "totalSetupMyr": { "type": "number" },
        "totalMonthlyMyr": { "type": "number" },
        "totalAnnualMyr": { "type": "number" },
        "totalContractValueMyr": { "type": "number" },
        "status": { "type": "string", "enum": ["Draft", "Pending Approval", "Approved", "Rejected", "Quotation Sent"] },
        "isApproved": { "type": "boolean" },
        "approvedBy": { "type": "string", "maxLength": 128 },
        "approvedByName": { "type": "string", "maxLength": 120 },
        "approvedAtIso": { "type": "string", "maxLength": 40 },
        "rejectionFeedback": { "type": "string", "maxLength": 2000 },
        "dispatchChannel": { "type": "string", "enum": ["", "Email", "WhatsApp", "Manual"] },
        "dispatchedAtIso": { "type": "string", "maxLength": 40 },
        "dispatchedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "quoteNumber", "leadId", "companyName", "assignedPicId", "createdBy", "approverIds",
        "scopeNotes", "legalRemarks", "assumptions", "exclusions", "totalSetupMyr", "totalMonthlyMyr",
        "totalAnnualMyr", "totalContractValueMyr", "status", "isApproved", "approvedBy", "approvedByName",
        "approvedAtIso", "rejectionFeedback", "dispatchChannel", "dispatchedAtIso", "dispatchedBy",
        "createdAt", "updatedAt"
      ]
    },
    "QuotationLineItem": {
      "title": "QuotationLineItem",
      "description": "Individual itemized fee line within a quotation subcollection.",
      "type": "object",
      "properties": {
        "quotationId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "serviceCategory": { "type": "string", "enum": ["CoSec", "Accounting", "Audit", "Tax", "Payroll", "Advisory"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "deliverables": { "type": "string", "maxLength": 1000 },
        "frequency": { "type": "string", "enum": ["One-off", "Monthly", "Annual"] },
        "quantity": { "type": "integer" },
        "unitPriceMyr": { "type": "number" },
        "lineTotalMyr": { "type": "number" },
        "assignedPicId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdBy": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "approverIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "quotationId", "serviceCategory", "description", "deliverables", "frequency", "quantity",
        "unitPriceMyr", "lineTotalMyr", "assignedPicId", "createdBy", "approverIds", "createdAt", "updatedAt"
      ]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable compliance and approval audit trail.",
      "type": "object",
      "properties": {
        "entityType": { "type": "string", "enum": ["Lead", "Quotation", "Config"] },
        "entityId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "entityLabel": { "type": "string", "maxLength": 160 },
        "action": {
          "type": "string",
          "enum": [
            "LEAD_INGESTED",
            "OUTREACH_LOGGED",
            "SLA_ESCALATED",
            "SCOPE_RECORDED",
            "QUOTATION_GENERATED",
            "QUOTATION_SUBMITTED",
            "QUOTATION_APPROVED",
            "QUOTATION_REJECTED",
            "QUOTATION_DISPATCHED",
            "CONFIG_UPDATED"
          ]
        },
        "actorUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorName": { "type": "string", "maxLength": 120 },
        "actorRole": { "type": "string", "maxLength": 40 },
        "details": { "type": "string", "maxLength": 2000 },
        "assignedPicId": { "type": "string", "maxLength": 128 },
        "approverIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "entityType", "entityId", "entityLabel", "action", "actorUid", "actorName",
        "actorRole", "details", "assignedPicId", "approverIds", "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profiles with email PII isolated strictly to owner and administrators."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Administrator registry for RBAC lookups."
    },
    "/settings/{configId}": {
      "schema": { "$ref": "#/entities/OrgConfig" },
      "description": "Organization SLA thresholds, Malaysian public holiday calendar, and department PIC mapping."
    },
    "/leads/{leadId}": {
      "schema": { "$ref": "#/entities/Lead" },
      "description": "Corporate advisory leads ingested from email and tracked across outreach, SLA, and scope."
    },
    "/quotations/{quotationId}": {
      "schema": { "$ref": "#/entities/Quotation" },
      "description": "Structured corporate advisory quotations with mandatory approval gating."
    },
    "/quotations/{quotationId}/lineItems/{itemId}": {
      "schema": { "$ref": "#/entities/QuotationLineItem" },
      "description": "Itemized setup, monthly, and annual fee lines belonging to a parent quotation."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable operational and managerial approval audit trail."
    }
  }
}
